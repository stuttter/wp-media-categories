{
  "name": "stuttter/wp-media-categories",
  "description": "Categories for media & attachments",
  "homepage": "https://github.com/stuttter/wp-media-categories",
  "type": "wordpress-plugin",
  "require": {
    "php": ">=7.4",
    "composer/installers": "^2.0"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
    "php-stubs/wordpress-stubs": "6.4.*",
    "phpstan/phpstan": "^2.2.13",
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "John James Jacoby",
      "email": "johnjamesjacoby@me.com"
    }
  ],
  "autoload-dev": {
    "classmap": [
      "tests/"
    ]
  },
  "scripts": {
    "phpcs": "php scripts/check-phpcs-baseline.php",
    "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.0"
    },
    "sort-packages": true
  }
}
