parameters:
    level: 7
    phpVersion: 70400
    paths:
        - wp-media-categories.php
        - wp-media-categories
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    stubFiles:
        - phpstan-wordpress-compat.stub
    tmpDir: build/phpstan
    parallel:
        maximumNumberOfProcesses: 1
